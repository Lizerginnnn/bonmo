# Скопируйте в .env.local и заполните, когда будете подключать отправку.
# Переменные с NEXT_PUBLIC_ попадают в код страницы при сборке — они видны всем,
# поэтому сюда можно класть только публичные ключи (ключ Web3Forms такой).
# Токен Telegram-бота сюда класть НЕЛЬЗЯ.

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
NEXT_PUBLIC_SHEETS_ENDPOINT=
