# Скопируйте в .env.local и заполните. После изменения перезапустите yarn dev.
# Переменные с NEXT_PUBLIC_ попадают в код страницы и видны всем — секреты (токен бота) сюда НЕ класть.

# Адрес веб-приложения Google Apps Script (заканчивается на /exec), см. google-apps-script/README.md
NEXT_PUBLIC_SUBMIT_ENDPOINT=
